# Telegram: token de @BotFather y el ID del único chat autorizado
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# LLM (respaldo cuando el agente local no está disponible)
GROQ_API_KEY=
GEMINI_API_KEY=

# Voz (Fish Audio) para notas de voz
FISH_AUDIO_API_KEY=
FISH_AUDIO_API_KEY_BACKUP=

# Moodle: enlace iCal exportado desde Calendario > Exportar calendario
MOODLE_ICAL_URL=

# Rutas opcionales (por defecto se buscan en tu carpeta personal)
# AGY_BIN=~/.local/bin/agy
# GCALENDAR_BIN=~/.gemini/antigravity/bin/gcalendar
# OBSIDIAN_VAULT_DIR=~/Documents/Obsidian Vault
# OBSIDIAN_PDF_DIR=~/Desktop/PDF OBSIDIAN
# LIFE_OS_CONFIG=config/config.json
